# Imagen de desarrollo del panel de coordinadores.
# Base: Playwright (Ubuntu jammy) — ya trae Node y Chromium con sus
# dependencias de sistema, que usan los tests de QA de vistas
# (skill webapp-testing) y las auditorías con axe-core.
# La versión de la imagen tiene que coincidir con @playwright/test en package.json.
FROM mcr.microsoft.com/playwright:v1.63.0-jammy

WORKDIR /app

# Dependencias primero, para aprovechar la caché de capas.
COPY package.json package-lock.json ./
RUN npm ci

COPY . .

ENV NEXT_TELEMETRY_DISABLED=1

EXPOSE 3000

CMD ["npm", "run", "dev"]
